# Public Supabase project settings. These values are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only. Never expose these through NEXT_PUBLIC_* variables.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 32-byte key encoded as 64 hexadecimal characters for AES-256-GCM.
PLAYER_DATA_ENCRYPTION_KEY=replace-with-64-hex-characters

# A separate high-entropy secret used only for deterministic duplicate checks.
PLAYER_IDENTITY_HASH_SECRET=replace-with-a-long-random-secret

# Fail-closed feature flags. Keep false until licensing, provider approval,
# production credentials, webhook verification, and operational controls exist.
PAYMENTS_ENABLED=false
WITHDRAWALS_ENABLED=false
KYC_UPLOADS_ENABLED=false

# Capitec Pay Me is kept server-side and fails closed. Do not enable these
# until written merchant/legal approval and a tested reconciliation process exist.
CAPITEC_DIRECT_DEPOSIT_APPROVED=false
CAPITEC_RECONCILIATION_ENABLED=false
# Development may use an absolute local path. Production must use an HTTPS URL
# to private, access-controlled storage; this value is never returned to clients.
CAPITEC_PAYME_QR_SOURCE=
# Exact hostname permitted for the production HTTPS source (no scheme or path).
CAPITEC_PAYME_QR_ALLOWED_HOST=
# Required in production. SHA-256 of the approved QR image, lowercase hex.
CAPITEC_PAYME_QR_SHA256=
